# Semantic-conditioning run (2026-10-21): emilia_small's update 150000 + frozen GTE-ModernColBERT token vectors on
# the characters ("option B"), trained to 200000 with the same data order; emilia_small 150k -> 200k is the anchor.
# Config: src/f5_tts/configs/F5TTS_v1_Small_Emilia_EN_sem.yaml. Checkpoints: ckpts/F5TTS_v1_Small_vocos_pinyin_Emilia_EN_sem.
# One job on general (8 GPUs, SAVES_PER_SESSION=0); results/emilia_small[_online] link to the anchor's results.
export CFG=F5TTS_v1_Small_Emilia_EN_sem
export F5_LOGGER=wandb
export WANDB_MODE=online
export WANDB_PROJECT=CFM-TTS
export WANDB_NAME=f5-train-emilia-small-sem
export WANDB_RUN_ID=f5tts-emilia-small-sem-20261021
export WANDB_RESUME=allow
# named checkpoint every 10k (config); on_checkpoint.sh queues a held-out loss eval every 10k and a full eval
# (WER/SIM/UTMOS + loss) every 50k, i.e. at 200000 next to emilia_small's
export F5_ON_CHECKPOINT="bash /data/group_data/UTD-NAS/chanjanh/speechgen/F5-TTS-sem/repro/on_checkpoint.sh emilia_small_sem F5TTS_v1_Small_Emilia_EN_sem"
export LAST=1000
# 2026-10-21 20:06: two one-node 4 x L40S starts (babel-u5-28) died at DDP's first NCCL collective ("Error while
# attaching to shared memory segment /dev/shm/nccl-"), also with P2P off (babel-o9-20). Now launched with
# SPREAD=node (srun, one task per GPU, the NCCL settings emilia_small runs with on L40S nodes).
export NCCL_P2P_DISABLE=1
export NCCL_DEBUG=WARN
# 2026-10-21 21:49: NCCL's shared-memory setup also failed with the srun launch on babel-p9-28 ("attaching to shared
# memory segment /dev/shm/nccl-<garbage>"), as before on babel-u5-28 and babel-o9-20 (it works on q5-28 and x5-28).
# Ranks on one node use sockets instead; read at each session start, so a running session is not affected.
export NCCL_SHM_DISABLE=1
