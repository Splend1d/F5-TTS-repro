# Online W&B logging for the long-running TAG=main training run.
# The stable ID makes every preemption/resubmission continue the same run.
export F5_LOGGER=wandb
export WANDB_MODE=online
export WANDB_PROJECT=CFM-TTS
export WANDB_NAME=f5-train-main
export WANDB_RUN_ID=f5tts-main-20260930
export WANDB_RESUME=allow

# 2026-10-03: from update 5,500 the main run continues on Emilia EN only (data/Emilia_EN_pinyin, checkpoints in
# ckpts/F5TTS_v1_Base_vocos_pinyin_Emilia_EN, seeded with the ZH+EN update-5,500 checkpoint). total_updates pins
# the LR schedule and end of training to the original ZH+EN run (11 epochs x 115,551 updates).
export EXTRA="++datasets.name=Emilia_EN ++optim.total_updates=1271061"
