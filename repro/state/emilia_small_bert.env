# Control run (2026-10-21): emilia_small_sem with ModernBERT-base (MLM only, no retrieval training) instead of
# GTE-ModernColBERT; everything else identical. Config: src/f5_tts/configs/F5TTS_v1_Small_Emilia_EN_bert.yaml.
# Checkpoints: ckpts/F5TTS_v1_Small_vocos_pinyin_Emilia_EN_bert. 4 GPUs on one node, srun launch (SPREAD=node).
export CFG=F5TTS_v1_Small_Emilia_EN_bert
export F5_LOGGER=wandb
export WANDB_MODE=online
export WANDB_PROJECT=CFM-TTS
export WANDB_NAME=f5-train-emilia-small-bert
export WANDB_RUN_ID=f5tts-emilia-small-bert-20261021
export WANDB_RESUME=allow
export F5_ON_CHECKPOINT="bash /data/group_data/UTD-NAS/chanjanh/speechgen/F5-TTS-sem/repro/on_checkpoint.sh emilia_small_bert F5TTS_v1_Small_Emilia_EN_bert"
export LAST=1000
export NCCL_DEBUG=WARN
# 2026-10-21 21:49: NCCL's shared-memory setup also failed with the srun launch on babel-p9-28 ("attaching to shared
# memory segment /dev/shm/nccl-<garbage>"), as before on babel-u5-28 and babel-o9-20 (it works on q5-28 and x5-28).
# Ranks on one node use sockets instead; read at each session start, so a running session is not affected.
export NCCL_SHM_DISABLE=1
